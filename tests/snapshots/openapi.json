{
  "components": {
    "schemas": {
      "ConfigApplyResponse": {
        "additionalProperties": false,
        "description": "Response model for ``POST /config/apply``.",
        "properties": {
          "applied": {
            "title": "Applied",
            "type": "boolean"
          },
          "blockers": {
            "items": {
              "type": "string"
            },
            "title": "Blockers",
            "type": "array"
          },
          "state": {
            "$ref": "#/components/schemas/ReadinessState"
          }
        },
        "required": [
          "applied",
          "state",
          "blockers"
        ],
        "title": "ConfigApplyResponse",
        "type": "object"
      },
      "ConfigStatusResponse": {
        "additionalProperties": false,
        "description": "Response model for ``GET /config/status``.",
        "properties": {
          "blockers": {
            "items": {
              "type": "string"
            },
            "title": "Blockers",
            "type": "array"
          },
          "config_present": {
            "title": "Config Present",
            "type": "boolean"
          },
          "state": {
            "$ref": "#/components/schemas/ReadinessState"
          }
        },
        "required": [
          "state",
          "blockers",
          "config_present"
        ],
        "title": "ConfigStatusResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LLMConfigPayload": {
        "additionalProperties": false,
        "description": "Typed request model for config apply and validate endpoints.",
        "properties": {
          "profiles": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Profiles",
            "type": "array"
          }
        },
        "required": [
          "profiles"
        ],
        "title": "LLMConfigPayload",
        "type": "object"
      },
      "ReadinessState": {
        "description": "Readiness states reported by ``/ready`` and used internally by readiness service.",
        "enum": [
          "unconfigured",
          "partially_configured",
          "ready"
        ],
        "title": "ReadinessState",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "_RotatePayload": {
        "properties": {
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "_RotatePayload",
        "type": "object"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
