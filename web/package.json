{
  "name": "@qtsone/workflows-mcp-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:client": "openapi-typescript ../tests/snapshots/openapi.json -o src/api/generated/schema.d.ts",
    "check:client": "npm run generate:client && node ./scripts/check-generated-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude e2e/**",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "openapi-fetch": "^0.14.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "25.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.6.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
